#!/usr/bin/env bash
set -euo pipefail

# railoxide-isolated — Run RailOxide in a bubblewrap sandbox with no access
# to your home directory, /root, or other personal data.

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
DATA_DIR="${RAILOXIDE_DATA:-$SCRIPT_DIR/../data}"
BINARY="${RAILOXIDE_BINARY:-railoxide}"
DISPLAY="${DISPLAY:-}"
WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"

usage() {
  cat <<'EOF'
Usage: railoxide-isolated [-- <wallet-args>...]

Run the RailOxide wallet inside a bubblewrap sandbox:
  - /home, /root, and /run/user are empty tmpfs mounts
  - /tmp is a private tmpfs
  - The Nix store is exposed read-only for dynamic libraries
  - Only X11/Wayland sockets and GPU devices are forwarded
  - All data is stored in RAILOXIDE_DATA (default: data/ inside the project)

Environment variables:
  RAILOXIDE_BINARY  Path or name of the railoxide binary (default: railoxide)
  RAILOXIDE_DATA    Data directory to bind-mount into the sandbox
                    (default: data/ inside the project)

Examples:
  railoxide-isolated
  RAILOXIDE_DATA=/secure/railoxide-data railoxide-isolated
  railoxide-isolated -- --db-path /data
EOF
  exit 0
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && usage

WALLET_ARGS=()
if [[ $# -gt 0 ]]; then
  WALLET_ARGS=("$@")
fi

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

command_exists bwrap || die 'bwrap (bubblewrap) is not installed. Run: nix run nixpkgs#bubblewrap'

if ! command -v "$BINARY" >/dev/null 2>&1; then
  die "'$BINARY' not found. Build the wallet first or set RAILOXIDE_BINARY."
fi

BINARY_PATH="$(realpath "$(command -v "$BINARY")")"
WAYLAND_LIBDIR="$(pkg-config --variable=libdir wayland-client)"
SYSTEM_CA_BUNDLE="$(readlink -f /etc/ssl/certs/ca-bundle.crt 2>/dev/null || true)"
LD_LIBRARY_PATH_VALUE="$WAYLAND_LIBDIR"
VULKAN_LIBDIR="$(pkg-config --variable=libdir vulkan 2>/dev/null || true)"

if [[ -n "$VULKAN_LIBDIR" ]]; then
  LD_LIBRARY_PATH_VALUE="$LD_LIBRARY_PATH_VALUE:$VULKAN_LIBDIR"
fi

if [[ -d /run/opengl-driver/lib ]]; then
  LD_LIBRARY_PATH_VALUE="$LD_LIBRARY_PATH_VALUE:/run/opengl-driver/lib"
fi

if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
  LD_LIBRARY_PATH_VALUE="$LD_LIBRARY_PATH_VALUE:$LD_LIBRARY_PATH"
fi

# Host GPU drivers (Mesa/LLVM) are built against the system glibc, which can be
# newer than the glibc the wallet was built with. dlopen of the Vulkan ICD then
# fails with "version `GLIBC_x.y' not found", wgpu reports no adapters, and the
# window never opens. Detect that skew and relaunch through the host glibc's
# dynamic loader so the driver's symbol versions resolve.
HOST_LDSO=""

glibc_version_of() {
  # Extract "2.44-25" from a /nix/store/<hash>-glibc-2.44-25/lib/libc.so.6 path.
  local dir
  dir="$(basename "$(dirname "$(dirname "$1")")")"
  [[ "$dir" == *glibc-* ]] || return 1
  printf '%s\n' "${dir##*glibc-}"
}

if command_exists readelf && command_exists ldd; then
  binary_ldso="$(readelf -l "$BINARY_PATH" 2>/dev/null | sed -n 's/.*Requesting program interpreter: \(.*\)\]/\1/p')"
  binary_glibc="$(glibc_version_of "$binary_ldso" 2>/dev/null || true)"

  host_glibc=""
  host_glibc_dir=""
  for icd in /run/opengl-driver/share/vulkan/icd.d/*.json; do
    [[ -f "$icd" ]] || continue
    icd_lib="$(sed -n 's/.*"library_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$icd" | head -n1)"
    [[ -f "$icd_lib" ]] || continue
    # Skip foreign-architecture ICDs (e.g. 32-bit) that ldd cannot inspect.
    [[ "$(readelf -h "$icd_lib" 2>/dev/null | sed -n 's/.*Class: *//p')" == *64* ]] || continue
    icd_libc="$(ldd "$icd_lib" 2>/dev/null | sed -n 's/.*libc\.so\.6 => \([^ ]*\).*/\1/p' | head -n1)"
    icd_glibc="$(glibc_version_of "$icd_libc" 2>/dev/null || true)"
    [[ -n "$icd_glibc" ]] || continue
    if [[ -z "$host_glibc" ]] ||
      [[ "$(printf '%s\n%s\n' "$host_glibc" "$icd_glibc" | sort -V | tail -n1)" == "$icd_glibc" ]]; then
      host_glibc="$icd_glibc"
      host_glibc_dir="$(dirname "$(dirname "$icd_libc")")"
    fi
  done

  if [[ -n "$binary_glibc" && -n "$host_glibc" ]] &&
    [[ "$host_glibc" != "$binary_glibc" ]] &&
    [[ "$(printf '%s\n%s\n' "$binary_glibc" "$host_glibc" | sort -V | tail -n1)" == "$host_glibc" ]]; then
    for candidate in "$host_glibc_dir"/lib/ld-linux*.so.* "$host_glibc_dir"/lib/ld-*.so.*; do
      if [[ -x "$candidate" ]]; then
        HOST_LDSO="$candidate"
        break
      fi
    done
    if [[ -n "$HOST_LDSO" ]]; then
      LD_LIBRARY_PATH_VALUE="$host_glibc_dir/lib:$LD_LIBRARY_PATH_VALUE"
    fi
  fi
fi

if [[ -z "$DISPLAY" && -z "$WAYLAND_DISPLAY" ]]; then
  die 'Neither DISPLAY nor WAYLAND_DISPLAY is set. Running outside a graphical session?'
fi

mkdir -p "$DATA_DIR"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Phase 1: Isolation base — empty tmpfs mounts go first
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

BWRAP=(
  bwrap
  --unshare-ipc
  --unshare-pid
  --unshare-uts
  --unshare-cgroup-try
  --share-net
  --hostname railoxide

  # Empty personal directories (must come before overlay binds)
  --tmpfs /home
  --tmpfs /root
  --tmpfs /run/user
  --tmpfs /tmp
  --tmpfs /var/tmp

  # System essentials (read-only)
  --proc /proc
)

# Reconstruct directory tree for the binary under the empty /home tmpfs,
# so the binary can live at its original absolute path and its ELF RUNPATH
# still resolves (e.g. $ORIGIN/../lib relative entries).
binary_parent="$(dirname "$BINARY_PATH")"
IFS='/' read -ra path_parts <<< "${binary_parent#/}"
current=""
for part in "${path_parts[@]}"; do
  current="$current/$part"
  BWRAP+=(--dir "$current")
done
BWRAP+=(--ro-bind "$BINARY_PATH" "$BINARY_PATH")

[[ -d /sys/class    ]] && BWRAP+=(--ro-bind /sys/class    /sys/class)
[[ -d /sys/dev/char ]] && BWRAP+=(--ro-bind /sys/dev/char /sys/dev/char)
[[ -d /sys/devices  ]] && BWRAP+=(--ro-bind /sys/devices  /sys/devices)

for etc_file in passwd group resolv.conf; do
  [[ -f "/etc/$etc_file" ]] && BWRAP+=(--ro-bind "/etc/$etc_file" "/etc/$etc_file")
done

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Phase 2: Host resources (Nix store, GPU, data) — overlay on top of tmpfs
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Sandbox scratch space for the Wayland socket (unaffected by /run/user tmpfs)
BWRAP+=(--dir "/run/railoxide")

BWRAP+=(
  # Nix store and runtime linker
  --ro-bind /nix/store /nix/store
)

[[ -d /run/current-system ]] && BWRAP+=(--ro-bind /run/current-system /run/current-system)
[[ -d /run/opengl-driver  ]] && BWRAP+=(--ro-bind /run/opengl-driver  /run/opengl-driver)

# GPU
[[ -d /dev/dri ]] && BWRAP+=(--dev-bind /dev/dri /dev/dri)

# Fonts
[[ -d /etc/fonts ]] && BWRAP+=(--ro-bind /etc/fonts /etc/fonts)

# Data directory
BWRAP+=(--bind "$DATA_DIR" "$DATA_DIR")

# Optional: hardware wallet USB devices
[[ -e /dev/bus/usb ]] && BWRAP+=(--dev-bind /dev/bus/usb /dev/bus/usb)

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Phase 3: Display sockets — create dirs on tmpfs, then overlay binds
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# X11
if [[ -n "$DISPLAY" ]]; then
  BWRAP+=(--setenv DISPLAY "$DISPLAY")
  if [[ -d /tmp/.X11-unix ]]; then
    BWRAP+=(--dir /tmp/.X11-unix)
    BWRAP+=(--ro-bind /tmp/.X11-unix /tmp/.X11-unix)
  fi
fi

# Wayland — socket goes into /run/railoxide since /run/user is tmpfs
if [[ -n "$WAYLAND_DISPLAY" ]]; then
  xdg_runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  wayland_socket="$xdg_runtime/$WAYLAND_DISPLAY"
  wayland_lock="$xdg_runtime/wayland-1.lock"

  if [[ -e "$wayland_socket" ]]; then
    BWRAP+=(--ro-bind "$wayland_socket" "/run/railoxide/$WAYLAND_DISPLAY")
  fi
  if [[ -e "$wayland_lock" ]]; then
    BWRAP+=(--ro-bind "$wayland_lock" "/run/railoxide/wayland-1.lock")
  fi

  BWRAP+=(--setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY")
  BWRAP+=(--setenv XDG_RUNTIME_DIR "/run/railoxide")
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Phase 4: Environment and exec
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

BWRAP+=(
  --setenv HOME             "/tmp"
  --setenv XDG_DATA_HOME    "$DATA_DIR"
  --setenv XDG_CONFIG_HOME  "$DATA_DIR/config"
  --setenv XDG_CACHE_HOME   "$DATA_DIR/cache"
  --setenv XDG_STATE_HOME   "$DATA_DIR/state"
  --setenv LD_LIBRARY_PATH  "$LD_LIBRARY_PATH_VALUE"
  --setenv SSL_CERT_FILE    "$SYSTEM_CA_BUNDLE"
  --setenv NIX_SSL_CERT_FILE "$SYSTEM_CA_BUNDLE"
  --setenv RUST_LOG         "${RUST_LOG:-info}"
)

if [[ -n "$HOST_LDSO" ]]; then
  BWRAP+=("$HOST_LDSO" --library-path "$LD_LIBRARY_PATH_VALUE" "$BINARY_PATH" --db-path "$DATA_DIR" "${WALLET_ARGS[@]}")
else
  BWRAP+=("$BINARY_PATH" --db-path "$DATA_DIR" "${WALLET_ARGS[@]}")
fi

exec "${BWRAP[@]}"
